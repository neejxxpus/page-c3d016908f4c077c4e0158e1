ht: 800;color: var(--text-main);line-height: 1}\n.plan-subprice {font-size: 0.8rem;color: var(--text-muted);margin-top: 4px}\n.feature-list-plain {list-style: none;font-size: 0.875rem;color: #374151}\n.feature-list-plain li {margin-bottom: 4px;position: relative;padding-left: 14px}\n.feature-list-plain li::before {content: \"•\";position: absolute;left: 0;color: var(--orange)}\n.table-action-link {display: inline-block;font-size: 0.85rem;font-weight: 700;color: var(--orange);border: 1px solid var(--orange);padding: 8px 14px;background: #ffffff;transition: all 0.15s ease}\n.table-action-link:hover {background: var(--orange);color: #ffffff}\n\n/* 客户端说明栏 */\n.client-note-box {background: var(--surface);border: 1px solid var(--border);border-left: 5px solid var(--text-main);padding: 24px}\n.client-step-grid {display: grid;grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));gap: 16px;margin-top: 20px}\n.step-item {border-top: 2px solid var(--border);padding-top: 12px}\n.step-num {font-weight: 800;color: var(--orange);font-size: 0.85rem;margin-bottom: 4px}\n.step-item h4 {font-size: 1rem;margin-bottom: 6px}\n.step-item p {font-size: 0.85rem;color: var(--text-muted)}\n\n/* 双栏问答 FAQ */\n.faq-grid {display: grid;grid-template-columns: 1fr 1fr;gap: 24px}\n.faq-entry {background: var(--surface);border: 1px solid var(--border);border-left: 4px solid var(--orange);padding: 20px 22px}\n.faq-entry h3 {font-size: 1.05rem;font-weight: 700;margin-bottom: 8px;color: var(--text-main)}\n.faq-entry p {font-size: 0.9rem;color: #4b5563;line-height: 1.6}\n\n/* 底部固定式文字导航 */\n.fixed-bottom-nav {position: fixed;bottom: 0;left: 0;width: 100%;background: rgba(255, 255, 255, 0.94);backdrop-filter: blur(10px);-webkit-backdrop-filter: blur(10px);border-top: 1px solid var(--border);z-index: 1000;padding: 12px 20px}\n.bottom-nav-inner {max-width: 1120px;margin: 0 auto;display: flex;justify-content: space-between;align-items: center}\n.brand-tiny {font-weight: 800;font-size: 1rem;color: var(--text-main);letter-spacing: -0.01em}\n.brand-tiny span {color: var(--orange)}\n.nav-links {display: flex;gap: 20px;list-style: none}\n.nav-links a {font-size: 0.85rem;font-weight: 600;color: var(--text-muted);transition: color 0.15s ease}\n.nav-links a:hover {color: var(--orange)}\n\n/* 响应式调整 */\n@media (max-width: 768px) {.dashboard-hero {\n    grid-template-columns: 1fr;}\n  .dash-main,\n  .dash-metric-1,\n  .dash-stat-sm-1,\n  .dash-stat-sm-2,\n  .dash-stat-sm-3 {\n    grid-column: span 1;}\n  .brand-h1 {\n    font-size: 2rem;}\n  .faq-grid {\n    grid-template-columns: 1fr;}\n  .nav-links {\n    gap: 12px;}}\n</style><main>\n  <div class=\"top-meta\">\n    <span>ARCHITECTURE DIGEST // ISSUE 42</span>\n    <span class=\"live-indicator\"><span class=\"live-dot\"></span> 实时网络拓扑记录</span>\n  </div>\n\n  \n  <header class=\"dashboard-hero\">\n    <div class=\"dash-tile dash-main\">\n      <div>\n        <h1 class=\"brand-h1\">用理性的带宽调度，<br>重构日常体验：<span>Sky</span></h1>\n        <p class=\"lead-quote\">在复杂的公网路由震荡中，我们观察到连接的本质不在于浮夸的速度虚标，而在于冗余线路的静默切换与低抖动交付。</p>\n      </div>\n      <div>\n        专栏评析 · 订阅架构与多端生态实录\n      </div>\n    </div>\n\n    <div class=\"dash-tile dash-metric-1\">\n      <span class=\"metric-label\">最高并发容纳</span>\n      <div class=\"metric-number\">20 台</div>\n      <div class=\"metric-desc\">高阶集群覆盖团队级终端同态在线测试，不设置单点设备绑定锁。</div>\n    </div>\n\n    <div class=\"dash-tile dash-stat-sm-1\">\n      <span class=\"stat-tag\">01 / 流量配额</span>\n      <h3 class=\"stat-headline\">100G ~ 1000G</h3>\n      <p>从个人日常轻度漫游到团队级全天候工程调度，分阶设定严谨容量。</p>\n    </div>\n\n    <div class=\"dash-tile dash-stat-sm-2\">\n      <span class=\"stat-tag\">02 / 传输优化</span>\n      <h3 class=\"stat-headline\">IPLC 专线互联</h3>\n      <p>针对核心节点引入端对端中继隧道，削减公网过境震荡与抖动。</p>\n    </div>\n\n    <div class=\"dash-tile dash-stat-sm-3\">\n      <span class=\"stat-tag\">03 / 响应保障</span>\n      <h3 class=\"stat-headline\">7×24 优先工单</h3>\n      <p>旗舰级与团队订阅提供专职路由调度排查，缩短故障恢复等待。</p>\n    </div>\n  </header>\n\n  \n  <section class=\"article-section\" id=\"essays\">\n    <div class=\"section-header\">\n      <div class=\"section-eyebrow\">PERSPECTIVE</div>\n      <h2 class=\"section-title\">专栏观察：现代跨境流转的三个支点</h2>\n      <p class=\"section-intro\">我们回顾了过去数年公共骨干网的拥塞特征，归纳出评测网络服务健壮性的底层标准。</p>\n    </div>\n    <div class=\"card-grid\">\n      <article class=\"stripe-card\">\n        <h3>多重节点池的动态降级</h3>\n        <p>在骨干缆线突发中断时，单一节点集群往往造成全链路阻断。Sky 构建的普通与专享多梯队节点池，通过自动路由侦测，确保在极端拥塞场景下仍保留可用信道。</p>\n      </article>\n      <article class=\"stripe-card\">\n        <h3>流媒体的区域策略解锁</h3>\n        <p>数字内容平台对原生 IP 属性要求日趋苛刻。基于原生机房出口清洗技术，Sky 将旗舰节点与区域媒体服务解耦，保障数据包在传输全流程的纯净度。</p>\n      </article>\n      <article class=\"stripe-card\">\n        <h3>企业级路由定制化</h3>\n        <p>针对特定协作软件、版本控制仓或游戏服务器的高频诉求，定制分流规则可避免非必要中转，将有效带宽精准分配给延迟敏感任务。</p>\n      </article>\n    </div>\n  </section>\n\n  \n  <section class=\"article-section\" id=\"plans\">\n    <div class=\"section-header\">\n      <div class=\"section-eyebrow\">SUBSCRIPTION MATRIX</div>\n      <h2 class=\"section-title\">分级用量与权益对照</h2>\n      <p class=\"section-intro\">剔除晦涩条款，所有层级的流量额度、连接终端上限与调度权益均一目了然。</p>\n    </div>\n\n    <div class=\"table-container\">\n      <table class=\"plan-table\">\n        <thead>\n          <tr>\n            <th>版本名称</th>\n            <th>订阅资费</th>\n            <th>年付权益</th>\n            <th>关键核心特性</th>\n            <th>操作</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td>\n              <div class=\"plan-name\">基础版</div>\n            </td>\n            <td>\n              <div class=\"plan-price\">¥15 <span>/ 月</span></div>\n            </td>\n            <td>\n              <div class=\"plan-subprice\">按年付仅需 ¥150/年</div>\n            </td>\n            <td>\n              <ul class=\"feature-list-plain\">\n                <li>每月 100GB 极速流量</li>\n                <li>支持 3 台设备同时在线</li>\n                <li>解锁基础流媒体</li>\n                <li>普通线路节点池</li>\n              </ul>\n            </td>\n            <td>\n              <a href=\"#\" class=\"table-action-link\">选择方案</a>\n            </td>\n          </tr>\n          <tr class=\"highlighted\">\n            <td>\n              <div class=\"plan-name\">旗舰版 <span class=\"badge-hot\">推荐</span></div>\n            </td>\n            <td>\n              <div class=\"plan-price\">¥35 <span>/ 月</span></div>\n            </td>\n            <td>\n              <div class=\"plan-subprice\">按年付仅需 ¥350/年</div>\n            </td>\n            <td>\n              <ul class=\"feature-list-plain\">\n                <li>每月 300GB 极速流量</li>\n                <li>支持 5 台设备同时在线</li>\n                <li>全节点原生流媒体解锁</li>\n                <li>IPLC 专线游戏加速优化</li>\n                <li>7x24 优先工单支持</li>\n              </ul>\n            </td>\n            <td>\n              <a href=\"#\" class=\"table-action-link\">优先订阅</a>\n            </td>\n          </tr>\n          <tr>\n            <td>\n              <div class=\"plan-name\">团队版</div>\n            </td>\n            <td>\n              <div class=\"plan-price\">¥85 <span>/ 月</span></div>\n            </td>\n            <td>\n              <div class=\"plan-subprice\">按年付仅需 ¥850/年</div>\n            </td>\n            <td>\n              <ul class=\"feature-list-plain\">\n                <li>每月 1000GB 极速流量</li>\n                <li>支持 20 台设备同时在线</li>\n                <li>VIP 专属高带宽节点</li>\n                <li>支持企业定制路由</li>\n                <li>专属客户经理服务</li>\n              </ul>\n            </td>\n            <td>\n              <a href=\"#\" class=\"table-action-link\">配置团队</a>\n            </td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  \n  <section class=\"article-section\" id=\"clients\">\n    <div class=\"section-header\">\n      <div class=\"section-eyebrow\">INTEGRATION GUIDE</div>\n      <h2 class=\"section-title\">客户端适配与接入步骤</h2>\n      <p class=\"section-intro\">遵循通用协议标准，用户可自由接入主流多平台分流工具。</p>\n    </div>\n\n    <div class=\"client-note-box\">\n      <h3>通用订阅链接交付机制</h3>\n      <p>\n        Sky 依托标准订阅协议向用户分发配置。目前暂无独立专有封装客户端发布，用户可直接选用符合开源规范的第三方代理内核或图形化工具（如 Clash、Sing-box、Surge、v2rayN 等），通过订阅 URL 同步节点清单与策略规则。\n      </p>\n\n      <div class=\"client-step-grid\">\n        <div class=\"step-item\">\n          <div class=\"step-num\">STEP 01</div>\n          <h4>获取通用订阅</h4>\n          <p>完成方案配置后，在个人仪表板内复制专属的聚合订阅 URL。</p>\n        </div>\n        <div class=\"step-item\">\n          <div class=\"step-num\">STEP 02</div>\n          <h4>载入配置应用</h4>\n          <p>在 Windows、macOS、iOS 或 Android 客户端中选择“导入订阅”并填入链接。</p>\n        </div>\n        <div class=\"step-item\">\n          <div class=\"step-num\">STEP 03</div>\n          <h4>设定分流规则</h4>\n          <p>根据使用偏好选择按规则分流模式，实现国内直连与跨境任务精准分轨。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"article-section\" id=\"faq\">\n    <div class=\"section-header\">\n      <div class=\"section-eyebrow\">CLEAR ANSWERS</div>\n      <h2 class=\"section-title\">常见问题与运行细则</h2>\n      <p class=\"section-intro\">从计费周期、设备限制到技术维护，专栏作者梳理的客观说明。</p>\n    </div>\n\n    <div class=\"faq-grid\">\n      <div class=\"faq-entry\">\n        <h3>每月流量何时重置？耗尽后会发生什么？</h3>\n        <p>各版本流量按实际账单月周期自动重置，而非自然月的第一天。若当期流量耗尽，路由系统将暂停节点响应，直至下一个账单日或用户主动增购临时叠加包。</p>\n      </div>\n\n      <div class=\"faq-entry\">\n        <h3>同时在线设备数如何界定？</h3>\n        <p>设备数指在同一时间向 Sky 节点发起活跃 TCP/UDP 会话的独立物理终端数量。路由器部署按 1 台计，但下属所有局域网设备共享该出口与相应带宽阈值。</p>\n      </div>\n\n      <div class=\"faq-entry\">\n        <h3>基础版与旗舰版节点在体验上有何差异？</h3>\n        <p>基础版采用常规骨干网链路，高峰期可能面临公网抖动；旗舰版则引入了专用 IPLC 专线路由，有效规避晚间高峰阻塞，并支持更严苛的原生流媒体解锁与低延迟游戏需求。</p>\n      </div>\n\n      <div class=\"faq-entry\">\n        <h3>是否提供专属的图形化客户端安装包？</h3>\n        <p>当前 Sky 专注底层节点分发与路由维护，不提供自研封装的应用程序。用户需使用受支持的第三方开源或成熟分流工具，并通过标准订阅链接完成节点下发。</p>\n      </div>\n    </div>\n  </section>\n</main>\n\n\n<nav class=\"fixed-bottom-nav\">\n  <div class=\"bottom-nav-inner\">\n    <div class=\"brand-tiny\">Sky <span>ARCHIVE</span></div>\n    <ul class=\"nav-links\">\n      <li><a href=\"#essays\">论述</a></li>\n      <li><a href=\"#plans\">订阅方案</a></li>\n      <li><a href=\"#clients\">接入指南</a></li>\n      <li><a href=\"#faq\">常见问题</a></li>\n    </ul>\n  </div>\n</nav>",
