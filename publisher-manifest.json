          "version": 3,
          "body": "<style>\n:root {--bg: #ffffff;--surface: #fafafa;--surface-subtle: #f4f4f5;--border: #e4e4e7;--text-main: #18181b;--text-muted: #71717a;--orange: #ff5500;--orange-light: #fff3ed;--orange-hover: #e04b00}\n* {box-sizing: border-box;margin: 0;padding: 0}\nbody {font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif;background-color: var(--bg);color: var(--text-main);line-height: 1.65;padding-bottom: 90px;-webkit-font-smoothing: antialiased}\na {color: inherit;text-decoration: none}\nmain {max-width: 1120px;margin: 0 auto;padding: 32px 20px 60px}\n\n/* 顶部极简标记 */\n.top-meta {display: flex;justify-content: space-between;align-items: center;font-size: 0.85rem;letter-spacing: 0.05em;text-transform: uppercase;color: var(--text-muted);border-bottom: 1px solid var(--border);padding-bottom: 12px;margin-bottom: 32px}\n.live-indicator {display: inline-flex;align-items: center;gap: 8px}\n.live-dot {width: 8px;height: 8px;background: var(--orange);border-radius: 50%}\n\n/* 首屏：仪表盘式数据块拼贴 */\n.dashboard-hero {display: grid;grid-template-columns: repeat(12, 1fr);gap: 16px;margin-bottom: 64px}\n.dash-tile {background: var(--surface);border: 1px solid var(--border);padding: 24px;position: relative}\n.dash-main {grid-column: span 7;display: flex;flex-direction: column;justify-content: space-between;background: #ffffff}\n.brand-h1 {font-size: 2.75rem;line-height: 1.15;font-weight: 800;letter-spacing: -0.02em;color: var(--text-main);margin-bottom: 16px}\n.brand-h1 span {color: var(--orange)}\n.lead-quote {font-size: 1.05rem;color: var(--text-muted);max-width: 90%;margin-top: 12px}\n.dash-metric-1 {grid-column: span 5;background: var(--orange-light);border-color: rgba(255, 85, 0, 0.2)}\n.metric-number {font-size: 3rem;font-weight: 800;color: var(--orange);line-height: 1;margin: 12px 0 6px;font-variant-numeric: tabular-nums}\n.metric-label {font-size: 0.85rem;font-weight: 600;text-transfor